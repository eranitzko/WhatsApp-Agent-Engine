# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Google Gemini (invoice OCR) ───────────────────────────────────────────────
GEMINI_API_KEY=

# ── Cloudflare R2 (invoice image storage) ────────────────────────────────────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=          # optional CDN prefix, e.g. https://cdn.example.com

# ── Gmail SMTP (report delivery) ──────────────────────────────────────────────
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
REPORT_EMAIL_ALLOWLIST= # comma-separated; leave empty to allow only GMAIL_USER

# ── Notion (optional) ─────────────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_TASKS_DATABASE_ID=

# ── WhatsApp ──────────────────────────────────────────────────────────────────
BOT_PHONE_NUMBER=972...
ADMIN_PHONE_NUMBER=972...
LEGACY_GROUP_JID=120363...@g.us   # pre-existing invoice curator group JID
WEBHOOK_SECRET=                    # optional, secures /webhook endpoint

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////data/db/whatsapp_agent.db

# ── Internal services (Docker Compose service names) ─────────────────────────
BRIDGE_URL=http://bridge:3000

# ── Family Accounting ─────────────────────────────────────────────────────────
# JSON object: display name → WhatsApp phone (no +, no spaces)
FAMILY_MEMBERS_JSON={"Eran": "972...", "Sivan": "972...", "Eden": "972...", "Roni": "972...", "Bar": "972...", "Tomer": "972..."}

# Comma-separated names of members who share one household account (the parents).
# Balances between them are not tracked; they appear as "Parents" in reports.
FAMILY_HOUSEHOLD_MEMBERS=Eran,Sivan
